# ============================================================
#  Root-level .gitignore — Smart Sembako Assistant
#  File ini melindungi root folder dari file sensitif/besar
# ============================================================

# --- Konfigurasi sensitif (API key, token, dsb) ---
config.json
*.env
.env*
*credentials*.json
*service-account*.json
automation-sheets-*.json
*-b2b070766971.json
data/*.db
data/memory.db
data/baileys-session*/

# --- Runtime besar (jangan di-push ke repo) ---
cloudflared.exe
*.exe
*.zip
*.rar
runtimes/

# --- Log & error ---
*.log
AIChatError.log

# --- Build / compile output ---
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# --- IDE & editor ---
.vs/
.vscode/
.idea/
*.user
*.suo

# --- OS generated ---
Thumbs.db
.DS_Store
desktop.ini

# --- Node.js (jika ada di root) ---
node_modules/
**/node_modules/

# --- Temporary ---
Tempt/
.codex-build/
.codex-obj-upgrade/
*.tmp
*.bak

# --- NuGet ---
*.nupkg
