<UserControl x:Class="SmartSembakoAssistant.Views.AIChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Chat Bubble Style: User Message -->
        <Style x:Key="UserMessageStyle" TargetType="Border">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="CornerRadius" Value="12,12,0,12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="60,4,4,8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="500"/>
        </Style>

        <!-- Chat Bubble Style: AI Message -->
        <Style x:Key="AiMessageStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12,12,12,0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="4,4,60,8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="500"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input TextBox Style -->
        <Style x:Key="ChatInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="MaxHeight" Value="120"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- Send Button Style -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9CA3AF"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModeComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListBox Item Template for Chat Messages -->
        <DataTemplate x:Key="ChatMessageTemplate">
            <Border CornerRadius="12,12,12,0" Padding="14,10" MaxWidth="500" HorizontalAlignment="Left" Margin="4,4,60,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Direction="270"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                <Setter Property="Background" Value="#3B82F6"/>
                                <Setter Property="CornerRadius" Value="12,12,0,12"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="60,4,4,8"/>
                                <Setter Property="Effect" Value="{x:Null}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap" LineHeight="20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1F2937"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="9" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="Text" Value="{Binding Timestamp, StringFormat='HH:mm'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#B4FFFFFF"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Drawer Toggle -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock Grid.Column="0" Text="💬 AI Chat Assistant" FontSize="18" FontWeight="SemiBold"
                           Foreground="#1F2937" VerticalAlignment="Center"/>

                <!-- Status Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtModelStatus" Text="Groq AI" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Controls Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- System Prompt Selector -->
                <TextBlock Grid.Column="0" Text="Mode:" FontSize="12" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbPromptMode" Grid.Column="1" Style="{StaticResource ModeComboBoxStyle}"
                          SelectionChanged="CmbPromptMode_SelectionChanged" VerticalAlignment="Center">
                    <ComboBoxItem Content="👔 Owner Mode" Tag="Owner" IsSelected="True"/>
                    <ComboBoxItem Content="💼 Kasir Mode" Tag="Kasir"/>
                    <ComboBoxItem Content="🗣️ General" Tag="General"/>
                </ComboBox>

                <!-- Spacer -->
                <TextBlock Grid.Column="2"/>

                <!-- Clear Chat Button -->
                <Button x:Name="BtnClearChat" Grid.Column="3" Content="🗑️ Clear Chat"
                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnClearChat_Click" Margin="0,0,8,0"/>
            </Grid>
        </Border>

        <!-- Chat Messages Area -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <ListBox x:Name="LstChatMessages"
                     BorderThickness="0"
                     Background="#F9FAFB"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     ItemTemplate="{StaticResource ChatMessageTemplate}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Empty State -->
        <Border Grid.Row="2" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center"
                x:Name="EmptyStatePanel" Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="💬" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.5"/>
                <TextBlock Text="Mulai percakapan dengan AI" FontSize="14" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                <TextBlock Text="Ketik pesan di bawah dan tekan Enter atau klik Kirim" FontSize="11" Foreground="#D1D5DB" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Input Area -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtMessageInput" Grid.Column="0" Style="{StaticResource ChatInputStyle}"
                         KeyDown="TxtMessageInput_KeyDown"
                         VerticalAlignment="Center" Margin="0,0,0,0"/>

                <Button x:Name="BtnSend" Grid.Column="1" Content="📤"
                        Style="{StaticResource SendButtonStyle}" Click="BtnSend_Click"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="14,10">
            <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="10" Foreground="#6B7280" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
