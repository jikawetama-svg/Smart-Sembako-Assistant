<UserControl x:Class="SmartSembakoAssistant.Views.SalesAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PeriodButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="PeriodButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource PeriodButtonStyle}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Penjualan" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock Text="Ringkasan analitik, detail transaksi, dan ekspor laporan dalam satu halaman."
                               FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnExportCSV" Content="CSV" Style="{StaticResource ExportButtonStyle}" Click="BtnExportCSV_Click"/>
                    <Button x:Name="BtnExportExcel" Content="Excel" Style="{StaticResource ExportButtonStyle}" Click="BtnExportExcel_Click"/>
                    <Button x:Name="BtnExportPDF" Content="PDF" Style="{StaticResource ExportButtonStyle}" Click="BtnExportPDF_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Periode:" FontSize="12" FontWeight="SemiBold"
                           Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="BtnToday" Grid.Column="1" Content="Hari Ini" Style="{StaticResource PeriodButtonActiveStyle}" Click="BtnToday_Click"/>
                <Button x:Name="BtnThisWeek" Grid.Column="2" Content="Minggu Ini" Style="{StaticResource PeriodButtonStyle}" Click="BtnThisWeek_Click"/>
                <Button x:Name="BtnThisMonth" Grid.Column="3" Content="Bulan Ini" Style="{StaticResource PeriodButtonStyle}" Click="BtnThisMonth_Click"/>

                <DatePicker x:Name="DpStartDate" Grid.Column="4" Width="130" Margin="8,0,8,0" SelectedDateFormat="Short"/>
                <TextBlock Grid.Column="5" Text="s/d" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="DpEndDate" Grid.Column="6" Width="130" Margin="0,0,8,0" SelectedDateFormat="Short"/>
                <Button x:Name="BtnApplyDate" Grid.Column="7" Content="Terapkan" HorizontalAlignment="Left"
                        Style="{StaticResource PeriodButtonStyle}" Click="BtnApplyDate_Click"/>
                <TextBlock x:Name="TxtLoading" Grid.Column="8" Text="Memuat..." FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent">
            <TabItem Header="Ringkasan Analitik">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
                        <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Total Revenue" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtTotalRevenue" Text="Rp 0" FontSize="22" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock x:Name="TxtRevenueLabel" Text="Periode" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Total Profit" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtTotalProfit" Text="Rp 0" FontSize="22" FontWeight="Bold" Foreground="#D97706"/>
                                <TextBlock x:Name="TxtProfitMargin" Text="Margin: -" FontSize="10" Foreground="#D97706"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Total Transaksi" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtTotalTransactions" Text="0" FontSize="22" FontWeight="Bold" Foreground="#2563EB"/>
                                <TextBlock x:Name="TxtTransactionLabel" Text="0 transaksi" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Rata-rata Transaksi" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtAvgTransaction" Text="Rp 0" FontSize="22" FontWeight="Bold" Foreground="#7C3AED"/>
                                <TextBlock x:Name="TxtAvgLabel" Text="Per transaksi" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Tren Penjualan Harian" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,12"/>
                                <Grid Grid.Row="1">
                                    <ItemsControl x:Name="IcSalesChart">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="54"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding FormattedDate}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Height="22" Background="#E2E8F0" CornerRadius="4" Margin="0,0,8,0">
                                                        <Border Height="22" Background="#10B981" CornerRadius="4" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedRevenue}" FontSize="11" Foreground="#334155" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="TxtChartNoData" Text="Belum ada data penjualan untuk periode ini"
                                               Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Top 10 Produk Terlaris" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,12"/>
                                <DataGrid Grid.Row="1" x:Name="DgTopProducts"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          FontSize="11" RowHeight="30" MaxHeight="320"
                                          EnableRowVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="40"/>
                                        <DataGridTextColumn Header="Produk" Binding="{Binding ProductName}" Width="*"/>
                                        <DataGridTextColumn Header="Qty" Binding="{Binding QuantitySold}" Width="70"/>
                                        <DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat='Rp {0:N0}'}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <UniformGrid Grid.Row="2" Columns="3">
                        <Border Style="{StaticResource SummaryCardStyle}" Background="#F0FDF4" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Pelanggan Unik" FontSize="11" Foreground="#166534"/>
                                <TextBlock x:Name="TxtUniqueCustomers" Text="0" FontSize="22" FontWeight="Bold" Foreground="#16A34A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCardStyle}" Background="#EFF6FF" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Pelanggan Terbaik" FontSize="11" Foreground="#1D4ED8"/>
                                <TextBlock x:Name="TxtBestCustomer" Text="-" FontSize="16" FontWeight="Bold" Foreground="#2563EB" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtBestCustomerSpent" Text="Tidak ada data" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCardStyle}" Background="#F5F3FF">
                            <StackPanel>
                                <TextBlock Text="Rata-rata / Hari" FontSize="11" Foreground="#6D28D9"/>
                                <TextBlock x:Name="TxtTxPerDay" Text="0" FontSize="22" FontWeight="Bold" Foreground="#7C3AED"/>
                                <TextBlock Text="Transaksi per hari" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Detail Transaksi">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,12">
                        <DataGrid x:Name="DgReports"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F8FAFC"
                                  FontSize="11" RowHeight="30"
                                  MaxHeight="520"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tanggal" Binding="{Binding Date, StringFormat='dd/MM/yyyy'}" Width="100"/>
                                <DataGridTextColumn Header="Invoice" Binding="{Binding Invoice}" Width="110"/>
                                <DataGridTextColumn Header="Produk" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70"/>
                                <DataGridTextColumn Header="Harga" Binding="{Binding Price, StringFormat='Rp {0:N0}'}" Width="110"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='Rp {0:N0}'}" Width="120"/>
                                <DataGridTextColumn Header="Profit" Binding="{Binding Profit, StringFormat='Rp {0:N0}'}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14,10">
                        <TextBlock x:Name="TxtReportInfo" Text="0 baris data" FontSize="12" Foreground="#64748B"/>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
            <TextBlock x:Name="TxtSalesStatus" Text="Siap memuat data penjualan." FontSize="12" Foreground="#64748B"/>
        </Border>
    </Grid>
</UserControl>
