<UserControl x:Class="SmartSembakoAssistant.Views.SalesAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Card Style with Hover Effect -->
        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.06" Direction="270"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.12" Direction="270"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Period Button Style -->
        <Style x:Key="PeriodButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Border.CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Active Period Button Style -->
        <Style x:Key="PeriodButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource PeriodButtonStyle}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                    <Setter Property="BorderBrush" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Date Picker Style -->
        <Style x:Key="DateInputStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Date Label Style -->
        <Style x:Key="DateLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Insight Card Style -->
        <Style x:Key="InsightCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06" Direction="270"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.12" Direction="270"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Title -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20,16" Margin="0,0,0,12">
            <TextBlock Text="&#128200; Sales Analytics" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937"/>
        </Border>

        <!-- Time Period Selector -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Periode:" FontSize="12" FontWeight="SemiBold"
                           Foreground="#374151" Margin="0,0,12,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToday" Content="Hari Ini" Style="{StaticResource PeriodButtonActiveStyle}"
                            Click="BtnToday_Click"/>
                    <Button x:Name="BtnThisWeek" Content="Minggu Ini" Style="{StaticResource PeriodButtonStyle}"
                            Click="BtnThisWeek_Click"/>
                    <Button x:Name="BtnThisMonth" Content="Bulan Ini" Style="{StaticResource PeriodButtonStyle}"
                            Click="BtnThisMonth_Click"/>
                    <Button x:Name="BtnCustom" Content="Custom" Style="{StaticResource PeriodButtonStyle}"
                            Click="BtnCustom_Click"/>
                </StackPanel>

                <!-- Custom Date Range (visible when Custom selected) -->
                <StackPanel x:Name="PanelCustomDate" Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Dari:" Style="{StaticResource DateLabelStyle}"/>
                    <DatePicker x:Name="DpStartDate" Style="{StaticResource DateInputStyle}"
                                Margin="0,0,10,0" SelectedDateFormat="Short"/>
                    <TextBlock Text="Sampai:" Style="{StaticResource DateLabelStyle}"/>
                    <DatePicker x:Name="DpEndDate" Style="{StaticResource DateInputStyle}"
                                Margin="0,0,10,0" SelectedDateFormat="Short"/>
                    <Button x:Name="BtnApplyDate" Content="&#128269; Apply"
                            Style="{StaticResource PeriodButtonActiveStyle}" Click="BtnApplyDate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary Cards (4 kolom) -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Revenue -->
            <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#ECFDF5" CornerRadius="6" Padding="8,6">
                            <TextBlock Text="&#128176;" FontSize="16"/>
                        </Border>
                        <TextBlock Text="Total Revenue" FontSize="11" Foreground="#6B7280" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtTotalRevenue" Text="Rp 0" FontSize="22" FontWeight="Bold"
                               Foreground="#10B981" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtRevenueLabel" Text="Periode saat ini" FontSize="10" Foreground="#9CA3AF"/>
                </StackPanel>
            </Border>

            <!-- Total Profit -->
            <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#FEF3C7" CornerRadius="6" Padding="8,6">
                            <TextBlock Text="&#128200;" FontSize="16"/>
                        </Border>
                        <TextBlock Text="Total Profit" FontSize="11" Foreground="#6B7280" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtTotalProfit" Text="Rp 0" FontSize="22" FontWeight="Bold"
                               Foreground="#F59E0B" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtProfitMargin" Text="Margin: -" FontSize="10" Foreground="#F59E0B"/>
                </StackPanel>
            </Border>

            <!-- Total Transactions -->
            <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="8,6">
                            <TextBlock Text="&#128203;" FontSize="16"/>
                        </Border>
                        <TextBlock Text="Total Transaksi" FontSize="11" Foreground="#6B7280" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtTotalTransactions" Text="0" FontSize="22" FontWeight="Bold"
                               Foreground="#3B82F6" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtTransactionLabel" Text="Transaksi" FontSize="10" Foreground="#9CA3AF"/>
                </StackPanel>
            </Border>

            <!-- Average Transaction -->
            <Border Grid.Column="3" Style="{StaticResource SummaryCardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#F5F3FF" CornerRadius="6" Padding="8,6">
                            <TextBlock Text="&#128179;" FontSize="16"/>
                        </Border>
                        <TextBlock Text="Rata-rata Transaksi" FontSize="11" Foreground="#6B7280" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtAvgTransaction" Text="Rp 0" FontSize="22" FontWeight="Bold"
                               Foreground="#8B5CF6" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtAvgLabel" Text="Per transaksi" FontSize="10" Foreground="#9CA3AF"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Top 10 Products -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="&#127942; Top 10 Produk Terlaris" FontSize="14" FontWeight="SemiBold"
                           Foreground="#111827" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="1" x:Name="DgTopProducts"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          CanUserSortColumns="True" SelectionMode="Single"
                          AlternatingRowBackground="#F9FAFB"
                          FontSize="11" RowHeight="30" MaxHeight="280">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="40"/>
                        <DataGridTextColumn Header="Produk" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Qty Terjual" Binding="{Binding QuantitySold}" Width="100"/>
                        <DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat='Rp {0:N0}'}" Width="130"/>
                        <DataGridTextColumn Header="Profit" Binding="{Binding Profit, StringFormat='Rp {0:N0}'}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Sales Trend Chart -->
        <Border Grid.Row="4" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="&#128200; Sales Trend" FontSize="14" FontWeight="SemiBold"
                           Foreground="#111827" Margin="0,0,0,12"/>
                <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                        Background="#FAFAFA" MinHeight="180">
                    <Grid Margin="12">
                        <!-- Chart area -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="IcSalesChart">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Date label -->
                                            <TextBlock Grid.Column="0" Text="{Binding FormattedDate}"
                                                       FontSize="11" Foreground="#6B7280"
                                                       VerticalAlignment="Center" TextAlignment="Right"
                                                       Margin="0,0,8,0"/>
                                            <!-- Bar background track -->
                                            <Border Grid.Column="1" Background="#E5E7EB" CornerRadius="4"
                                                    Height="24" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <!-- Bar fill -->
                                                <Border Background="#10B981" CornerRadius="4"
                                                        Height="24" HorizontalAlignment="Left"
                                                        Width="{Binding BarWidth}" MinWidth="4"/>
                                            </Border>
                                            <!-- Revenue label -->
                                            <TextBlock Grid.Column="2" Text="{Binding FormattedRevenue}"
                                                       FontSize="10" Foreground="#374151" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" MinWidth="100"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <!-- No data message -->
                        <TextBlock x:Name="TxtChartNoData" Text="Belum ada data penjualan untuk periode ini"
                                   FontSize="13" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Customer Insights -->
        <Border Grid.Row="5" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="&#128101; Customer Insights" FontSize="14" FontWeight="SemiBold"
                           Foreground="#111827" Margin="0,0,0,12"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Unique Customers -->
                    <Border Grid.Column="0" Style="{StaticResource InsightCardStyle}" Background="#ECFDF5" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Pelanggan Unik" FontSize="11" Foreground="#059669" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtUniqueCustomers" Text="0" FontSize="24" FontWeight="Bold"
                                       Foreground="#10B981"/>
                            <TextBlock Text="Total pelanggan berbeda" FontSize="10" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Best Customer -->
                    <Border Grid.Column="1" Style="{StaticResource InsightCardStyle}" Background="#EFF6FF" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Pelanggan Terbaik" FontSize="11" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtBestCustomer" Text="-" FontSize="14" FontWeight="Bold"
                                       Foreground="#3B82F6" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtBestCustomerSpent" Text="Rp 0" FontSize="10" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Transactions per Day -->
                    <Border Grid.Column="2" Style="{StaticResource InsightCardStyle}" Background="#F5F3FF" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Rata-rata / Hari" FontSize="11" Foreground="#7C3AED" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtTxPerDay" Text="0" FontSize="24" FontWeight="Bold"
                                       Foreground="#8B5CF6"/>
                            <TextBlock Text="Transaksi per hari" FontSize="10" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
