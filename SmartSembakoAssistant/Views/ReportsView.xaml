<UserControl x:Class="SmartSembakoAssistant.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Card Style with Hover Effect -->
        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.06" Direction="270"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.12" Direction="270"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Export Button Style -->
        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Border.CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Date Picker Style -->
        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="DateLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Title -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20,16" Margin="0,0,0,12">
            <TextBlock Text="&#128202; Reports &amp; Analytics" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937"/>
        </Border>

        <!-- Date Range & Export Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Dari:" Style="{StaticResource DateLabelStyle}"/>
                <DatePicker x:Name="DpStartDate" Grid.Column="1" Style="{StaticResource DatePickerStyle}" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="2" Text="Sampai:" Style="{StaticResource DateLabelStyle}"/>
                <DatePicker x:Name="DpEndDate" Grid.Column="3" Style="{StaticResource DatePickerStyle}" Margin="0,0,16,0"/>

                <Button x:Name="BtnApplyFilter" Grid.Column="4" Content="&#128269; Filter"
                        Style="{StaticResource ExportButtonStyle}" Click="BtnApplyFilter_Click"
                        Margin="0,0,0,0"/>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnExportCSV" Content="&#128229; CSV" Style="{StaticResource ExportButtonStyle}" Click="BtnExportCSV_Click"/>
                    <Button x:Name="BtnExportExcel" Content="&#128229; Excel" Style="{StaticResource ExportButtonStyle}" Click="BtnExportExcel_Click"/>
                    <Button x:Name="BtnExportPDF" Content="&#128229; PDF" Style="{StaticResource ExportButtonStyle}" Click="BtnExportPDF_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary Cards (4 kolom) -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Sales -->
            <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#D1FAE5" CornerRadius="6" Padding="8,6">
                            <TextBlock Text="&#128176;" FontSize="16"/>
                        </Border>
                        <TextBlock Text="Total Sales" FontSize="11" Foreground="#6B7280" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtTotalSales" Text="Rp 0" FontSize="22" FontWeight="Bold"
                               Foreground="#059669" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtSalesPeriod" Text="-" FontSize="10" Foreground="#9CA3AF"/>
                </StackPanel>
            </Border>

            <!-- Total Profit -->
            <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#FEF3C7" CornerRadius="6" Padding="8,6">
                            <TextBlock Text="&#128200;" FontSize="16"/>
                        </Border>
                        <TextBlock Text="Total Profit" FontSize="11" Foreground="#6B7280" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtTotalProfit" Text="Rp 0" FontSize="22" FontWeight="Bold"
                               Foreground="#D97706" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtProfitMargin" Text="Margin: -" FontSize="10" Foreground="#F59E0B"/>
                </StackPanel>
            </Border>

            <!-- Items Sold -->
            <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="8,6">
                            <TextBlock Text="&#128230;" FontSize="16"/>
                        </Border>
                        <TextBlock Text="Items Sold" FontSize="11" Foreground="#6B7280" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtItemsSold" Text="0" FontSize="22" FontWeight="Bold"
                               Foreground="#2563EB" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtTransactionCount" Text="0 transaksi" FontSize="10" Foreground="#9CA3AF"/>
                </StackPanel>
            </Border>

            <!-- Top Product -->
            <Border Grid.Column="3" Style="{StaticResource SummaryCardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#FDF4FF" CornerRadius="6" Padding="8,6">
                            <TextBlock Text="&#11088;" FontSize="16"/>
                        </Border>
                        <TextBlock Text="Top Product" FontSize="11" Foreground="#6B7280" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtTopProduct" Text="-" FontSize="16" FontWeight="Bold"
                               Foreground="#7C3AED" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtTopProductQty" Text="0 terjual" FontSize="10" Foreground="#9CA3AF"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DataGrid -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,12">
            <DataGrid x:Name="DgReports"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      CanUserSortColumns="True" SelectionMode="Single"
                      AlternatingRowBackground="#F9FAFB"
                      FontSize="11" RowHeight="30">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tanggal" Binding="{Binding Date, StringFormat='dd/MM/yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="Invoice" Binding="{Binding Invoice}" Width="120"/>
                    <DataGridTextColumn Header="Produk" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70"/>
                    <DataGridTextColumn Header="Harga" Binding="{Binding Price, StringFormat='Rp {0:N0}'}" Width="110"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='Rp {0:N0}'}" Width="110"/>
                    <DataGridTextColumn Header="Profit" Binding="{Binding Profit, StringFormat='Rp {0:N0}'}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Chart Placeholder -->
        <Border Grid.Row="4" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="&#128200; Sales Trend" FontSize="14" FontWeight="SemiBold"
                           Foreground="#111827" Margin="0,0,0,12"/>
                <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                        Background="#F9FAFB" MinHeight="180">
                    <TextBlock Text="[ Chart Placeholder - Sales Trend Visualization ]"
                               FontSize="12" Foreground="#9CA3AF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="14,10">
            <TextBlock x:Name="TxtReportInfo" Text="0 baris data" FontSize="11" Foreground="#6B7280"/>
        </Border>
    </Grid>
</UserControl>
