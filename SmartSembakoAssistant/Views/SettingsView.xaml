<UserControl x:Class="SmartSembakoAssistant.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Section Style -->
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Input Style -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Combo Style -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Test Button -->
        <Style x:Key="TestButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Border.CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E7EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Save Button -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Border.CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- AI PRIMARY -->
            <Border Grid.Row="0" Style="{StaticResource SectionStyle}">
                <StackPanel>
                    <TextBlock Text="🧠 AI PRIMARY (Groq)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="#10B981"/>
                    
                    <TextBlock Text="API Key:" FontSize="11" Margin="0,0,0,5" Foreground="#374151"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtGroqApiKey" Grid.Column="0" Style="{StaticResource InputStyle}" Margin="0,0,8,0"
                                 Text="••••••••••••" TextChanged="TxtGroqApiKey_TextChanged"/>
                        <Button x:Name="BtnShowGroqKey" Grid.Column="1" Content="👁️" Style="{StaticResource TestButtonStyle}" Margin="0,0,4,0" Click="BtnShowGroqKey_Click"/>
                        <Button x:Name="BtnTestGroq" Grid.Column="2" Content="🧪 Test" Style="{StaticResource TestButtonStyle}" Click="BtnTestGroq_Click"/>
                    </Grid>

                    <TextBlock Text="Model:" FontSize="11" Margin="0,0,0,5" Foreground="#374151"/>
                    <ComboBox x:Name="CmbGroqModel" Style="{StaticResource ComboStyle}" Margin="0,0,0,10">
                        <ComboBoxItem Content="llama-3.1-8b-instant" IsSelected="True"/>
                        <ComboBoxItem Content="llama-3.1-70b-versatile"/>
                        <ComboBoxItem Content="gemma2-9b-it"/>
                        <ComboBoxItem Content="mixtral-8x7b-32768"/>
                    </ComboBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Max Tokens:" FontSize="11" Margin="0,0,0,5" Foreground="#374151"/>
                            <TextBox x:Name="TxtMaxTokens" Style="{StaticResource InputStyle}" Text="1000"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Temperature:" FontSize="11" Margin="0,0,0,5" Foreground="#374151"/>
                            <TextBox x:Name="TxtTemperature" Style="{StaticResource InputStyle}" Text="0.7"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- AI FALLBACK -->
            <Border Grid.Row="1" Style="{StaticResource SectionStyle}">
                <StackPanel>
                    <TextBlock Text="🔄 AI FALLBACK (Gemini)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#F59E0B"/>
                    
                    <CheckBox x:Name="ChkEnableFallback" Content="Enable Fallback (auto-switch saat Groq error)" FontSize="11" Margin="0,0,0,10"
                              Checked="ChkEnableFallback_Changed" Unchecked="ChkEnableFallback_Changed"/>

                    <TextBlock Text="API Key:" FontSize="11" Margin="0,0,0,5" Foreground="#374151"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtGeminiApiKey" Grid.Column="0" Style="{StaticResource InputStyle}" Margin="0,0,8,0"
                                 Text="••••••••••••" TextChanged="TxtGeminiApiKey_TextChanged"/>
                        <Button x:Name="BtnShowGeminiKey" Grid.Column="1" Content="👁️" Style="{StaticResource TestButtonStyle}" Margin="0,0,4,0" Click="BtnShowGeminiKey_Click"/>
                        <Button x:Name="BtnTestGemini" Grid.Column="2" Content="🧪 Test" Style="{StaticResource TestButtonStyle}" Click="BtnTestGemini_Click"/>
                    </Grid>

                    <TextBlock Text="Model:" FontSize="11" Margin="0,0,0,5" Foreground="#374151"/>
                    <ComboBox x:Name="CmbGeminiModel" Style="{StaticResource ComboStyle}">
                        <ComboBoxItem Content="gemini-3.1-flash-lite-preview" IsSelected="True"/>
                        <ComboBoxItem Content="gemini-2.5-flash-lite"/>
                        <ComboBoxItem Content="gemma-4-31b"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- AI BEHAVIOR -->
            <Border Grid.Row="2" Style="{StaticResource SectionStyle}">
                <StackPanel>
                    <TextBlock Text="⚙️ AI BEHAVIOR" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#3B82F6"/>
                    
                    <CheckBox x:Name="ChkAutoSwitch" Content="Auto-switch ke Fallback saat error" FontSize="11" Margin="0,0,0,6" IsChecked="True"/>
                    <CheckBox x:Name="ChkCacheAI" Content="Cache AI responses (hemat API limit)" FontSize="11" Margin="0,0,0,10" IsChecked="True"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Retry Count:" FontSize="11" Margin="0,0,0,5" Foreground="#374151"/>
                            <TextBox x:Name="TxtRetryCount" Style="{StaticResource InputStyle}" Text="2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Auto Recovery (min):" FontSize="11" Margin="0,0,0,5" Foreground="#374151"/>
                            <TextBox x:Name="TxtAutoRecovery" Style="{StaticResource InputStyle}" Text="5"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Telegram -->
            <Border Grid.Row="3" Style="{StaticResource SectionStyle}">
                <StackPanel>
                    <TextBlock Text="🤖 Telegram Bot" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="Bot Token:" FontSize="11" Margin="0,0,0,5" Foreground="#374151"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtBotToken" Grid.Column="0" Style="{StaticResource InputStyle}" Margin="0,0,8,0"
                                 Text="••••••••••••" TextChanged="TxtBotToken_TextChanged"/>
                        <Button x:Name="BtnShowBotToken" Grid.Column="1" Content="👁️" Style="{StaticResource TestButtonStyle}" Click="BtnShowBotToken_Click"/>
                    </Grid>
                    <TextBlock Text="Owner Chat IDs:" FontSize="11" Margin="0,0,0,5" Foreground="#374151"/>
                    <TextBox x:Name="TxtOwnerChatIds" Style="{StaticResource InputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Database -->
            <Border Grid.Row="4" Style="{StaticResource SectionStyle}">
                <StackPanel>
                    <TextBlock Text="💾 Database" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="pos.db Path:" FontSize="11" Margin="0,0,0,5" Foreground="#374151"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPosDbPath" Grid.Column="0" Style="{StaticResource InputStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="BtnBrowse" Grid.Column="1" Content="Browse" Style="{StaticResource TestButtonStyle}" Click="BtnBrowse_Click"/>
                    </Grid>
                    <CheckBox x:Name="ChkAutoDetect" Content="Auto-detect pos.db path" FontSize="11" Margin="0,8,0,0"
                              Checked="ChkAutoDetect_Changed" Unchecked="ChkAutoDetect_Changed"/>
                </StackPanel>
            </Border>

            <!-- Save Buttons -->
            <Border Grid.Row="5" Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnTestConnections" Content="🧪 Test All Connections" Padding="14,8" FontSize="12" Margin="0,0,10,0" Click="BtnTestConnections_Click" Style="{StaticResource TestButtonStyle}"/>
                    <Button x:Name="BtnSave" Content="💾 Save Settings" Padding="16,8" FontSize="12" Click="BtnSave_Click" Style="{StaticResource SaveButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
