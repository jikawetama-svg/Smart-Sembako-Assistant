<Window x:Class="SmartSembakoAssistant.Views.BaileysPairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baileys Pairing"
        Width="640"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="CodeTileStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinWidth" Value="34"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Baileys Pairing" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Margin="0,6,0,0"
                       Text="Jendela ini akan tetap terbuka sampai WhatsApp terhubung atau Anda menutupnya. Jangan klik Generate Kode Baru jika kode saat ini masih aktif."
                       TextWrapping="Wrap"
                       Foreground="#64748B"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,18" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="Kode Pairing" FontWeight="SemiBold" Foreground="#065F46"/>
                    <TextBlock x:Name="TxtBotPhoneHint"
                               Text="Nomor bot: -"
                               Margin="0,6,0,0"
                               Foreground="#047857"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtPairingCode"
                               Text="-"
                               FontFamily="Consolas"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="#065F46"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                    <UniformGrid Columns="9" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Border Style="{StaticResource CodeTileStyle}">
                            <TextBlock x:Name="TxtCodeChar1" Text="-" FontFamily="Consolas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource CodeTileStyle}">
                            <TextBlock x:Name="TxtCodeChar2" Text="-" FontFamily="Consolas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource CodeTileStyle}">
                            <TextBlock x:Name="TxtCodeChar3" Text="-" FontFamily="Consolas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource CodeTileStyle}">
                            <TextBlock x:Name="TxtCodeChar4" Text="-" FontFamily="Consolas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="-" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource CodeTileStyle}">
                            <TextBlock x:Name="TxtCodeChar5" Text="-" FontFamily="Consolas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource CodeTileStyle}">
                            <TextBlock x:Name="TxtCodeChar6" Text="-" FontFamily="Consolas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource CodeTileStyle}">
                            <TextBlock x:Name="TxtCodeChar7" Text="-" FontFamily="Consolas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource CodeTileStyle}">
                            <TextBlock x:Name="TxtCodeChar8" Text="-" FontFamily="Consolas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="TxtCharacterHint"
                               Text=""
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Foreground="#0F766E"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtCodeCountdown"
                               Text="Menyiapkan kode..."
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"
                               Foreground="#047857"/>
                    <TextBlock Margin="0,14,0,0"
                               Text="Buka WhatsApp pada nomor bot yang sama, masuk ke Linked devices, pilih Link with phone number, lalu masukkan kode ini. Jangan generate ulang selama kode masih aktif."
                               TextWrapping="Wrap"
                               Foreground="#065F46"/>
                </StackPanel>
            </Border>

            <Border x:Name="BorderQrPairing"
                    Visibility="Collapsed"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Fallback QR Pairing" FontWeight="SemiBold" Foreground="#1E3A8A"/>
                    <TextBlock Margin="0,6,0,0"
                               Text="Scan QR ini dari WhatsApp nomor bot: Linked devices > Link a device. Gunakan ini jika kode pairing nomor telepon terus ditolak."
                               TextWrapping="Wrap"
                               Foreground="#1D4ED8"/>
                    <Border Background="White"
                            BorderBrush="#DBEAFE"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center">
                        <Image x:Name="ImgQrCode"
                               Width="260"
                               Height="260"
                               Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="TxtQrCountdown"
                               Text=""
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"
                               Foreground="#1D4ED8"/>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock x:Name="TxtPairingStatus" Text="Menyiapkan WhatsApp lokal..." FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtPairingDiagnostics" Margin="0,8,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Cek ulang kode sebelum menunggu pairing" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBox x:Name="TxtManualCodeCheck"
                             Margin="0,8,0,0"
                             Height="34"
                             FontFamily="Consolas"
                             FontSize="16"
                             CharacterCasing="Upper"
                             TextChanged="TxtManualCodeCheck_TextChanged"/>
                    <TextBlock x:Name="TxtManualCodeValidation"
                               Margin="0,6,0,0"
                               Foreground="#64748B"
                               Text="Ketik ulang kode dari layar HP jika ingin memastikan tidak ada karakter yang tertukar."
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="BtnCopyCode" Content="Copy Code" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Click="BtnCopyCode_Click"/>
                <Button x:Name="BtnGenerateCode" Content="Generate Kode Baru" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Click="BtnGenerateCode_Click"/>
                <Button x:Name="BtnGenerateQr" Content="Fallback QR" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Click="BtnGenerateQr_Click"/>
                <Button x:Name="BtnResetSession" Content="Reset Sesi Lokal" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Click="BtnResetSession_Click"/>
                <Button x:Name="BtnClose" Content="Tutup" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Click="BtnClose_Click"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
