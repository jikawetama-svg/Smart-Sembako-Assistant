{
  "Groq": {
    "ApiKey": "YOUR_GROQ_API_KEY",
    "Model": "llama-3.1-8b-instant",
    "FallbackApiKey": "YOUR_GEMINI_API_KEY",
    "FallbackModel": "gemini-3.1-flash-lite-preview",
    "TimeoutSeconds": 30,
    "MaxTokens": 500,
    "Temperature": 0.3
  },
  "Telegram": {
    "BotToken": "YOUR_TELEGRAM_BOT_TOKEN",
    "AllowedChatIds": [],
    "RateLimitSeconds": 5,
    "EnableVoiceNotes": false
  },
  "PosDb": {
    "DatabasePath": "C:\\Users\\{USERNAME}\\AppData\\Local\\Aronium\\Data\\pos.db",
    "AutoDetect": true
  },
  "GoogleSheets": {
    "CredentialsJsonPath": "credentials.json",
    "SpreadsheetId": "YOUR_SPREADSHEET_ID",
    "TransaksiSheetName": "Transaksi",
    "AnalitikSheetName": "Analitik",
    "LogSheetName": "Log"
  },
  "Memory": {
    "ShortTermHistoryCount": 10,
    "LongTermSummaryDays": 7,
    "DatabasePath": "data\\memory.db"
  },
  "Notifications": {
    "StockThresholds": [
      { "Level": 20, "Priority": "Low" },
      { "Level": 10, "Priority": "Medium" },
      { "Level": 5, "Priority": "High" }
    ],
    "ExpiryThresholds": [
      { "DaysBefore": 30, "Priority": "Warning" },
      { "DaysBefore": 7, "Priority": "Urgent" }
    ],
    "EnableDailySummary": false,
    "DailySummaryTime": "08:00",
    "CheckIntervalMinutes": 5
  },
  "App": {
    "Theme": "Light",
    "StartWithWindows": false,
    "MinimizeToTray": true,
    "LogPath": "data\\logs",
    "MaxLogDays": 30
  }
}
