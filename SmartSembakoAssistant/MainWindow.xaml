<Window x:Class="SmartSembakoAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Sembako Assistant"
        Icon="Resources/logo.png"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="SidebarBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#10B981"/>
        <SolidColorBrush x:Key="TextDark" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextLight" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        
        <!-- Navigation Button -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                BorderThickness="3,0,0,0" 
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#10B981"/>
                                <Setter Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bot Control Button -->
        <Style x:Key="BotButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Action Button -->
        <Style x:Key="QuickActionStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="DrawerColumn" Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar (Dark Theme) -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Logo -->
                <Border Grid.Row="0" Padding="16,16,16,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏪" FontSize="24"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Smart Sembako" FontSize="14" FontWeight="Bold" Foreground="#F1F5F9"/>
                                <TextBlock x:Name="TxtAppVersion" Text="Assistant v..." FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Height="1" Fill="#334155" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="0" Margin="12,68,12,8">
                    <Button x:Name="BtnDashboard" Content="📊  Dashboard"
                            Style="{StaticResource NavButtonStyle}" Tag="Active"
                            Click="BtnDashboard_Click" Margin="0,0,0,2"/>
                    <Button x:Name="BtnMonitoring" Content="📦  Stock"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnMonitoring_Click" Margin="0,0,0,2"/>
                    <Button x:Name="BtnAnalytics" Content="📈  Penjualan"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnAnalytics_Click" Margin="0,0,0,2"/>
                    <Button x:Name="BtnReports" Content="📑  Reports"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnReports_Click" Margin="0,0,0,2"
                            Visibility="Collapsed"/>
                    <Button x:Name="BtnAIChat" Content="💬  AI Chat"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnAIChat_Click" Margin="0,0,0,2"/>
                    <Button x:Name="BtnLogs" Content="📜  Logs"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnLogs_Click" Margin="0,0,0,2"/>
                    <Button x:Name="BtnSettings" Content="⚙️  Settings"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnSettings_Click" Margin="0,0,0,2"/>
                </StackPanel>

                <!-- Bot Control -->
                <Border Grid.Row="1" Background="#0F172A" CornerRadius="10" Padding="14" Margin="12,0,12,8" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="BOT STATUS" FontSize="9" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8"/>
                        <Border Background="#1E293B" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock x:Name="TxtBotStatus" Text="● Stopped" FontSize="13" FontWeight="Bold"
                                           Foreground="#EF4444" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtBotUptime" Text="-" FontSize="9" Foreground="#94A3B8"
                                           HorizontalAlignment="Center" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="BtnStartBot" Content="▶" 
                                    Style="{StaticResource BotButtonStyle}" Background="#10B981"
                                    Click="BtnStartBot_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnStopBot" Content="■" 
                                    Style="{StaticResource BotButtonStyle}" Background="#EF4444"
                                    Click="BtnStopBot_Click" IsEnabled="False" Margin="0,0,6,0"/>
                            <Button x:Name="BtnRestartBot" Content="↻" 
                                    Style="{StaticResource BotButtonStyle}" Background="#F59E0B"
                                    Click="BtnRestartBot_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Quick Actions -->
                <Border Grid.Row="2" Background="#0F172A" CornerRadius="10" Padding="14" Margin="12,0,12,12">
                    <StackPanel>
                        <TextBlock Text="QUICK ACTIONS" FontSize="9" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                        <Button Content="💰  Omzet Hari Ini" Style="{StaticResource QuickActionStyle}" Margin="0,0,0,2" Click="QuickAction_Omzet_Click"/>
                        <Button Content="⚠️  Cek Stok Minus" Style="{StaticResource QuickActionStyle}" Margin="0,0,0,2" Click="QuickAction_StokMinus_Click"/>
                        <Button Content="📦  Rekomendasi Restock" Style="{StaticResource QuickActionStyle}" Margin="0,0,0,2" Click="QuickAction_Restock_Click"/>
                        <Button Content="🔄  Sync Database" Style="{StaticResource QuickActionStyle}" Margin="0,0,0,2" Click="QuickAction_SyncDb_Click"/>
                        <Button Content="🧪  Test Connections" Style="{StaticResource QuickActionStyle}" Click="QuickAction_TestConnections_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar with Drawer Icon -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <!-- Drawer Toggle Icon (Large) -->
                        <Button x:Name="BtnDrawerToggle" Content="☰" 
                                Background="Transparent" BorderThickness="0"
                                Width="36" Height="36" FontSize="18"
                                Foreground="#374151" Cursor="Hand"
                                Click="BtnDrawerToggle_Click"
                                Margin="0,0,16,0"/>
                        <TextBlock x:Name="TxtPageTitle" Text="Dashboard" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtDateTime" Text="" FontSize="12" Foreground="{StaticResource TextLight}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Row="1" Background="#F1F5F9">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                    <ContentControl x:Name="MainContent"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
