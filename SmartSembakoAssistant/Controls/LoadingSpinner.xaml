<UserControl x:Class="SmartSembakoAssistant.Controls.LoadingSpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="LoadingControl">

    <UserControl.Resources>
        <Style x:Key="LoadingTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Visibility="{Binding IsLoading, ElementName=LoadingControl, Converter={StaticResource BooleanToVisibilityConverter}}">
        
        <!-- Animated Dots -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Ellipse x:Name="Dot1" Width="12" Height="12" Fill="#3B82F6" Margin="0,0,6,0">
                <Ellipse.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Dot2" Width="12" Height="12" Fill="#3B82F6" Margin="0,0,6,0">
                <Ellipse.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Dot3" Width="12" Height="12" Fill="#3B82F6">
                <Ellipse.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </StackPanel>

        <!-- Loading Text -->
        <TextBlock Text="{Binding LoadingText, ElementName=LoadingControl}" 
                   Style="{StaticResource LoadingTextStyle}"/>
    </StackPanel>
</UserControl>
